{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": ["config:best-practices", "group:allNonMajor", ":automergeMinor"],
  "ignorePresets": [":pinDevDependencies", "abandonments:recommended"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "platformCommit": "enabled",
  "semanticCommits": "disabled",

  "enabledManagers": ["cargo", "rust-toolchain", "github-actions", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update tools installed with taiki-e/install-action in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["(?m)^\\s*tool:\\s*(?<depName>[^@\\s]+)@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "datasourceTemplate": "crate",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Zig installed with mlugg/setup-zig in workflows",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["uses:\\s*mlugg/setup-zig@[^\\n]*\\n\\s*with:\\s*\\n\\s*version:\\s*(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "zig",
      "datasourceTemplate": "custom.zig",
      "versioningTemplate": "semver"
    }
  ],
  "customDatasources": {
    "zig": {
      "description": "The download index of ziglang.org, which mlugg/setup-zig installs from; the GitHub mirror of Zig no longer gets tags",
      "defaultRegistryUrlTemplate": "https://ziglang.org/download/index.json",
      "transformTemplates": ["{\"releases\": $each($, function($v, $k) { $k != \"master\" ? {\"version\": $k, \"releaseTimestamp\": $v.date} })}"]
    }
  },

  "minimumReleaseAge": "3 days",
  "minimumReleaseAgePackageManagerSync": true,
  "packageRules": [
    {
      "description": "Batch minor and patch updates weekly; everything else is raised as soon as it is available",
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["* 15-23 * * 4", "* 0-8 * * 5"]
    },
    {
      "description": "First-party actions; update immediately in their own group",
      "matchPackageNames": ["iorate/*"],
      "groupName": "first-party packages",
      "minimumReleaseAge": null,
      "schedule": null
    },
    {
      "description": "Treat minor updates of 0.x crates and tools like majors: separate PRs, no automerge",
      "matchManagers": ["cargo", "custom.regex"],
      "matchDatasources": ["crate", "custom.zig"],
      "matchCurrentVersion": "<1",
      "matchUpdateTypes": ["minor"],
      "groupName": null,
      "schedule": null,
      "automerge": false
    },
    {
      "description": "Rewrite the requirements in Cargo.toml so that cargo resolves all updates of a branch at once; a lock file update moves one crate at a time, which fails for crates that pin each other, like slint and slint-build",
      "matchManagers": ["cargo"],
      "rangeStrategy": "bump"
    }
  ],
  "lockFileMaintenance": {
    "schedule": ["* 9-23 * * 5"]
  }
}
