{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": ["config:best-practices", "group:allNonMajor", ":automergeMinor"],
  "ignorePresets": [":pinDevDependencies", "abandonments:recommended", ":maintainLockFilesWeekly"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "platformCommit": "enabled",
  "semanticCommits": "disabled",

  "enabledManagers": ["cargo", "rust-toolchain", "github-actions"],

  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Batch minor and patch updates weekly; everything else is raised as soon as it is available",
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["* * * * 5"]
    },
    {
      "description": "Treat minor updates of 0.x crates like majors: separate PRs, no automerge",
      "matchManagers": ["cargo"],
      "matchDatasources": ["crate"],
      "matchCurrentVersion": "<1",
      "matchUpdateTypes": ["minor"],
      "groupName": null,
      "schedule": null,
      "automerge": false
    }
  ]
}
