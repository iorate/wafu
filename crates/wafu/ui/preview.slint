import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct PreviewData {
    visible: bool,
    // In place of both panes; otherwise in place of the right pane.
    full: bool,
    // 0: lines of text, 1: an image (or nothing), 2: a message
    kind: int,
    message: string,
    detail: string,
}

export struct PreviewLine {
    // The line number, or the offset in the hex dump; empty for a continued
    // line and for the note about truncation.
    number: string,
    text: string,
}

export component PreviewWidget inherits Rectangle {
    in property <PreviewData> data;
    in property <[PreviewLine]> lines;
    // As many zeros as the widest line number or offset has digits; empty for no column.
    in property <string> number-sample;
    in property <image> picture;
    in property <bool> has-picture;

    callback rows-changed(rows: int);
    callback double-clicked();
    callback wheel(delta: length);

    // The height of one unwrapped line decides how many lines are asked for.
    property <length> row-height: measure.preferred-height;

    function report() {
        root.rows-changed(max(1, floor((root.height - 8px) / root.row-height)));
    }

    init => {
        root.report();
    }

    changed height => {
        root.report();
    }

    changed row-height => {
        root.report();
    }

    clip: true;
    background: Theme.colors.bg;

    measure := Text {
        text: "0";
        font-family: Theme.preview-font-family;
        font-size: Theme.preview-font-size;
        visible: false;
    }

    // The number column is as wide as the widest number or offset in the preview font.
    measure-number := Text {
        text: root.number-sample;
        font-family: Theme.preview-font-family;
        font-size: Theme.preview-font-size;
        visible: false;
    }

    // The lines wrap to the width; the ones past the bottom are cut off.
    if root.data.kind == 0: VerticalLayout {
        alignment: start;
        padding: 4px;

        for line in root.lines: HorizontalLayout {
            spacing: root.number-sample == "" ? 0 : 8px;

            Text {
                text: line.number;
                width: measure-number.preferred-width;
                horizontal-alignment: right;
                vertical-alignment: top;
                font-family: Theme.preview-font-family;
                font-size: Theme.preview-font-size;
                color: Theme.colors.fg;
                opacity: Theme.dim-text-alpha;
            }

            Text {
                text: line.text;
                // Works with the FemtoVG renderer too, though the documentation
                // lists only Qt and software.
                wrap: char-wrap;
                width: parent.width - measure-number.preferred-width - parent.spacing;
                font-family: Theme.preview-font-family;
                font-size: Theme.preview-font-size;
                color: Theme.colors.fg;
            }
        }
    }

    // Shrunk to fit, never enlarged: a small image keeps its size.
    if root.data.kind == 1 && root.has-picture: Image {
        property <length> natural-width: root.picture.width * 1px;
        property <length> natural-height: root.picture.height * 1px;
        property <bool> fits: self.natural-width <= root.width && self.natural-height <= root.height;

        source: root.picture;
        width: self.fits ? self.natural-width : root.width;
        height: self.fits ? self.natural-height : root.height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        image-fit: contain;
        image-rendering: smooth;
    }

    // Placed by hand with an explicit width: in a layout, a word-wrap Text
    // takes its longest word as its minimum width (`min-width: 0` does not
    // help), so an unbroken long line overflows instead of wrapping mid-word.
    if root.data.kind == 2: Text {
        text: root.data.message;
        width: root.width - 16px;
        x: 8px;
        y: (root.height - self.height) / 2;
        wrap: word-wrap;
        horizontal-alignment: center;
        font-family: Theme.preview-font-family;
        font-size: Theme.preview-font-size;
        color: Theme.colors.fg;
    }

    if root.data.full && root.data.detail != "": Rectangle {
        width: overlay.preferred-width + 16px;
        height: overlay.preferred-height + 8px;
        x: root.width - self.width - 8px;
        y: root.height - self.height - 8px;
        background: Palette.alternate-background.with-alpha(0.85);
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 4px;

        overlay := Text {
            text: root.data.detail;
            font-family: Theme.preview-font-family;
            font-size: Theme.preview-font-size;
            color: Palette.foreground;
        }
    }

    // The core owns the scroll position; a single click does nothing in a preview.
    TouchArea {
        double-clicked => {
            root.double-clicked();
        }

        scroll-event(event) => {
            root.wheel(event.delta-y);
            accept
        }
    }
}
