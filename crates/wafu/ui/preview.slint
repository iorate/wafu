import { Theme } from "theme.slint";

export struct PreviewData {
    visible: bool,
    // Which panes it takes the place of: one of them or both.
    covers-left: bool,
    covers-right: bool,
    // 0: lines of text, 1: an image (or nothing), 2: a message
    kind: int,
    hex-dump: bool,
    message: string,
    marked: bool,
}

export struct PreviewLine {
    index: int,
    // The line number, or the offset in the hex dump; empty for a continued
    // line and for the note about truncation.
    number: string,
    text: string,
}

// A line of the document in whole rows, so that the area is cut between rows.
component PreviewText inherits Text {
    in property <length> row-height;
    out property <int> rows: max(1, round(self.preferred-height / self.row-height));

    height: self.rows * self.row-height;
    // Works with the FemtoVG renderer too, though the documentation lists
    // only Qt and software.
    wrap: char-wrap;
    font-family: Theme.preview-font-family;
    font-size: Theme.preview-font-size;
    color: Theme.colors.fg;
}

export component PreviewWidget inherits Rectangle {
    in property <PreviewData> data;
    in property <[PreviewLine]> lines;
    in property <[PreviewLine]> before;
    in property <[PreviewLine]> tail;
    // As many zeros as the widest line number or offset has digits; empty for no column.
    in property <string> number-sample;
    in property <image> picture;
    in property <bool> has-picture;

    callback rows-changed(rows: int);
    callback double-clicked();
    callback wheel(delta: length);
    callback line-rows(index: int, rows: int);

    // The height of one unwrapped line is a row, which decides how many rows
    // the area has.
    property <length> row-height: measure.preferred-height;
    property <int> area-rows: max(1, floor((root.height - 8px) / root.row-height));
    // Two characters in a hex dump, to match the gaps inside its rows.
    property <length> number-spacing: root.number-sample == "" ? 0 : (root.data.hex-dump ? 2 : 1) * measure.preferred-width;
    property <length> text-width: root.width - 8px - measure-number.preferred-width - root.number-spacing;

    function report() {
        root.rows-changed(root.area-rows);
    }

    init => {
        root.report();
    }

    changed height => {
        root.report();
    }

    changed row-height => {
        root.report();
    }

    clip: true;
    background: root.data.marked ? Theme.colors.mark : Theme.colors.bg;

    measure := Text {
        text: "0";
        font-family: Theme.preview-font-family;
        font-size: Theme.preview-font-size;
        visible: false;
    }

    // The number column is as wide as the widest number or offset in the preview font.
    measure-number := Text {
        text: root.number-sample;
        font-family: Theme.preview-font-family;
        font-size: Theme.preview-font-size;
        visible: false;
    }

    // Each one is hidden on its own: a repeater under a parent that is not
    // drawn may never make its elements.
    for line in root.before: PreviewText {
        visible: false;
        width: root.text-width;
        row-height: root.row-height;
        text: line.text;
        init => {
            root.line-rows(line.index, self.rows);
        }
        changed rows => {
            root.line-rows(line.index, self.rows);
        }
    }

    for line in root.tail: PreviewText {
        visible: false;
        width: root.text-width;
        row-height: root.row-height;
        text: line.text;
        init => {
            root.line-rows(line.index, self.rows);
        }
        changed rows => {
            root.line-rows(line.index, self.rows);
        }
    }

    if root.data.kind == 0: Rectangle {
        x: 4px;
        y: 4px;
        width: root.width - 8px;
        height: root.area-rows * root.row-height;
        clip: true;

        VerticalLayout {
            alignment: start;

            for line in root.lines: HorizontalLayout {
                spacing: root.number-spacing;

                Text {
                    text: line.number;
                    width: measure-number.preferred-width;
                    horizontal-alignment: right;
                    vertical-alignment: top;
                    font-family: Theme.preview-font-family;
                    font-size: Theme.preview-font-size;
                    color: Theme.colors.line-number;
                }

                PreviewText {
                    width: root.text-width;
                    row-height: root.row-height;
                    text: line.text;
                    init => {
                        root.line-rows(line.index, self.rows);
                    }
                    changed rows => {
                        root.line-rows(line.index, self.rows);
                    }
                }
            }
        }
    }

    // Shrunk to fit, never enlarged: a small image keeps its size.
    if root.data.kind == 1 && root.has-picture: Image {
        property <length> natural-width: root.picture.width * 1px;
        property <length> natural-height: root.picture.height * 1px;
        property <bool> fits: self.natural-width <= root.width && self.natural-height <= root.height;

        source: root.picture;
        width: self.fits ? self.natural-width : root.width;
        height: self.fits ? self.natural-height : root.height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        image-fit: contain;
        image-rendering: smooth;
    }

    // Placed by hand with an explicit width: in a layout, a word-wrap Text
    // takes its longest word as its minimum width (`min-width: 0` does not
    // help), so an unbroken long line overflows instead of wrapping mid-word.
    if root.data.kind == 2: Text {
        text: root.data.message;
        width: root.width - 16px;
        x: 8px;
        y: (root.height - self.height) / 2;
        wrap: word-wrap;
        horizontal-alignment: center;
        font-family: Theme.preview-font-family;
        font-size: Theme.preview-font-size;
        color: Theme.colors.fg;
    }

    // The core owns the scroll position; a single click does nothing in a preview.
    TouchArea {
        double-clicked => {
            root.double-clicked();
        }

        scroll-event(event) => {
            root.wheel(event.delta-y);
            accept
        }
    }
}
