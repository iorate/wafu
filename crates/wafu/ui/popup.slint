import { CheckBox, ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct PopupItem {
    label: string,
    detail: string,
    // 0: none, 1: radio button, 2: check box
    mark: int,
    on: bool,
}

export struct PopupData {
    visible: bool,
    title: string,
    message: string,
    has-input: bool,
    cursor: int,
    // Reports work going on in the background and may be shown late.
    progress: bool,
}

// One input field. The part to select when it opens is given as byte
// offsets; all of it when they are equal.
export struct PopupField {
    label: string,
    secret: bool,
    select-start: int,
    select-end: int,
}

component PopupInput {
    in property <PopupField> field;
    in property <bool> labelled;
    in property <bool> single;
    // Which field holds the focus is the overlay's state; the field follows it.
    in property <bool> active;
    in-out property <string> text;

    callback key-input(text: string, control: bool, shift: bool, alt: bool, meta: bool);
    callback edited(text: string);
    callback accepted();
    callback move-focus();

    height: Theme.row-height + 6px;

    changed active => {
        if root.active {
            input.focus();
        }
    }

    HorizontalLayout {
        spacing: 8px;

        if root.labelled: Text {
            text: root.field.label;
            vertical-alignment: center;
            width: 72px;
        }

        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 2px;

            input := TextInput {
                x: 4px;
                width: parent.width - 8px;
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                input-type: root.field.secret ? InputType.password : InputType.text;
                text <=> root.text;

                // Typing replaces the selected part (the whole value
                // unless the core says otherwise); the arrows edit it.
                init => {
                    if root.active {
                        self.focus();
                    }
                    if root.field.select-end > root.field.select-start {
                        self.set-selection-offsets(root.field.select-start, root.field.select-end);
                    } else {
                        self.select-all();
                    }
                }

                edited => {
                    root.edited(self.text);
                }

                accepted => {
                    root.accepted();
                }

                // Esc goes to the core. With one field the arrows do too;
                // with more they and Tab move between the fields, which is
                // the UI's business alone.
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.key-input(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                        return accept;
                    }
                    if event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Tab || event.text == Key.Backtab {
                        if root.single {
                            if event.text != Key.Tab && event.text != Key.Backtab {
                                root.key-input(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                            }
                        } else {
                            root.move-focus();
                        }
                        return accept;
                    }
                    reject
                }
            }
        }
    }
}

export component PopupOverlay {
    in property <PopupData> data;
    in property <[PopupItem]> items;
    in property <[PopupField]> fields;
    in-out property <string> text;
    in-out property <string> text-2;

    callback key-input(text: string, control: bool, shift: bool, alt: bool, meta: bool);
    callback input-edited(field: int, text: string);
    callback input-accepted();

    property <int> visible-items: min(items.length, 12);
    // The field with the focus, counted from the top. The overlay is made
    // anew for each popup that has more than one field, so it starts at 0.
    property <int> focused-field: 0;

    // Dims the window and swallows clicks while the popup is open.
    Rectangle {
        background: Palette.background;
        opacity: 0.6;
    }

    TouchArea { }

    panel := Rectangle {
        width: min(root.width - 40px, 480px);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 3;
        background: Palette.alternate-background;
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 4px;

        content := VerticalLayout {
            padding: 8px;
            spacing: 6px;

            Text {
                text: data.title;
                font-weight: 700;
            }

            if data.message != "": Text {
                text: data.message;
                overflow: elide;
            }

            if root.fields.length >= 1: PopupInput {
                field: root.fields[0];
                labelled: root.fields.length >= 2;
                single: root.fields.length == 1;
                active: root.focused-field == 0;
                text <=> root.text;
                key-input(text, control, shift, alt, meta) => {
                    root.key-input(text, control, shift, alt, meta);
                }
                edited(text) => {
                    root.input-edited(0, text);
                }
                accepted => {
                    root.input-accepted();
                }
                move-focus => {
                    root.focused-field = 1;
                }
            }

            if root.fields.length >= 2: PopupInput {
                field: root.fields[1];
                labelled: true;
                single: false;
                active: root.focused-field == 1;
                text <=> root.text-2;
                key-input(text, control, shift, alt, meta) => {
                    root.key-input(text, control, shift, alt, meta);
                }
                edited(text) => {
                    root.input-edited(1, text);
                }
                accepted => {
                    root.input-accepted();
                }
                move-focus => {
                    root.focused-field = 0;
                }
            }

            if items.length > 0: Rectangle {
                property <int> cursor: root.data.cursor;

                height: root.visible-items * Theme.row-height;
                clip: true;

                list := ListView {
                    width: parent.width;
                    height: parent.height;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                    for item[index] in root.items: Rectangle {
                        height: Theme.row-height;
                        background: index == root.data.cursor ? Theme.selection-background : transparent;

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 8px;

                            if item.mark == 1: Rectangle {
                                width: 18px;

                                Rectangle {
                                    width: 14px;
                                    height: 14px;
                                    x: 2px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: Palette.foreground;

                                    if item.on: Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 3px;
                                        background: Palette.foreground;
                                    }
                                }
                            }

                            if item.mark == 2: CheckBox {
                                width: 18px;
                                checked: item.on;
                            }

                            Text {
                                text: item.label;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: item.detail;
                                opacity: 0.7;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                horizontal-stretch: 0;
                                min-width: self.preferred-width;
                            }
                        }
                    }
                }

                // The widgets only display the draft; clicks never reach them.
                TouchArea { }

                changed cursor => {
                    if self.cursor < 0 {
                        return;
                    }
                    if self.cursor * Theme.row-height < -list.content-y {
                        list.content-y = -self.cursor * Theme.row-height;
                    } else if (self.cursor + 1) * Theme.row-height > -list.content-y + list.visible-height {
                        list.content-y = -((self.cursor + 1) * Theme.row-height - list.visible-height);
                    }
                }
            }
        }
    }
}
