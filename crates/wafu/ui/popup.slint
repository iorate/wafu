import { CheckBox, ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct PopupItem {
    label: string,
    detail: string,
    // 0: choice, 1: check box, 2: separator
    kind: int,
    on: bool,
}

export struct PopupData {
    visible: bool,
    title: string,
    message: string,
    note: string,
    has-input: bool,
    has-list: bool,
    cursor: int,
    scroll-top: int,
    // Reports work going on in the background and may be shown late.
    progress: bool,
    generation: int,
}

// One input field. The part to select when it opens is given as byte
// offsets, which put the caret there when they are equal.
export struct PopupField {
    label: string,
    secret: bool,
    select-all: bool,
    select-start: int,
    select-end: int,
}

component PopupText inherits Text {
    font-family: Theme.popup-font-family;
    font-size: Theme.popup-font-size;
}

component PopupInput {
    in property <PopupField> field;
    in property <bool> labelled;
    in property <length> label-width;
    in property <bool> single;
    // Which field holds the focus is the overlay's state; the field follows it,
    // since an element inside `if` cannot be reached from outside.
    in property <bool> active;
    in property <int> generation;
    // False while the popup is closing: the field is about to go, and taking
    // the focus then would leave the window without a focused element.
    in property <bool> open;
    in-out property <string> text;

    callback key-input(text: string, control: bool, shift: bool, alt: bool, meta: bool);
    callback edited(text: string);
    callback accepted();
    callback move-focus();

    height: Theme.popup-row-height + 6px;

    changed active => {
        if root.active {
            input.focus();
        }
    }

    // A popup replaced by another with one field keeps the same element, so
    // `init` does not run again; the generation tells the two apart. It also
    // changes when the popup closes, and this runs in the same pass as the
    // handler that gives the focus back to the file list, in no fixed order:
    // focusing the field then can win and leave no focused element.
    changed generation => {
        if root.open {
            root.select-initial();
        }
    }

    // Typing replaces the selected part (the whole value
    // unless the core says otherwise); the arrows edit it.
    function select-initial() {
        if root.active {
            input.focus();
        }
        input.scroll = 0;
        if root.field.select-all {
            input.select-all();
        } else {
            input.set-selection-offsets(root.field.select-start, root.field.select-end);
        }
    }

    HorizontalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 8px;

        if root.labelled: PopupText {
            text: root.field.label;
            vertical-alignment: center;
            width: root.label-width;
        }

        Rectangle {
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 2px;

            // TextInput does not scroll by itself, so it sits in a clipped
            // viewport and is moved to keep the caret in view.
            Rectangle {
                x: 4px;
                width: parent.width - 8px;
                height: parent.height;
                clip: true;

                input := TextInput {
                    // Where the caret last asked the text to be. The bounds keep
                    // deleting text or widening the popup from leaving a blank
                    // gap on the right.
                    property <length> scroll;
                    x: min(0px, max(parent.width - self.width, self.scroll));
                    // Wide enough for the caret after the last character.
                    width: max(parent.width, self.preferred-width + self.text-cursor-width);
                    height: parent.height;
                    font-family: Theme.popup-font-family;
                    font-size: Theme.popup-font-size;
                    vertical-alignment: center;
                    single-line: true;
                    input-type: root.field.secret ? InputType.password : InputType.text;
                    text <=> root.text;

                    init => {
                        root.select-initial();
                    }

                    cursor-position-changed(pos) => {
                        if pos.x + self.x < 0 {
                            self.scroll = -pos.x;
                        } else if pos.x + self.x > parent.width - self.text-cursor-width {
                            self.scroll = parent.width - self.text-cursor-width - pos.x;
                        } else {
                            self.scroll = self.x;
                        }
                    }

                    edited => {
                        root.edited(self.text);
                    }

                    accepted => {
                        root.accepted();
                    }

                    // Esc goes to the core. With one field the arrows do too;
                    // with more they and Tab move between the fields, which is
                    // the UI's business alone.
                    key-pressed(event) => {
                        if event.text == Key.Escape {
                            root.key-input(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                            return accept;
                        }
                        if event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Tab || event.text == Key.Backtab {
                            if root.single {
                                if event.text != Key.Tab && event.text != Key.Backtab {
                                    root.key-input(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
                                }
                            } else {
                                root.move-focus();
                            }
                            return accept;
                        }
                        reject
                    }
                }
            }
        }
    }
}

// An overlay in the window rather than a `PopupWindow`, whose contents cannot
// be reached from outside, as editing a draft from the keyboard needs.
export component PopupOverlay {
    in property <PopupData> data;
    in property <[PopupItem]> items;
    in property <[PopupField]> fields;
    in-out property <string> text;
    in-out property <string> text-2;

    callback key-input(text: string, control: bool, shift: bool, alt: bool, meta: bool);
    callback input-edited(field: int, text: string);
    callback input-accepted();
    callback list-rows-changed(rows: int);
    callback row-clicked(row: int);
    callback row-double-clicked(row: int);
    callback wheel(delta: length);

    property <int> fixed-rows: 1 + (data.message != "" ? 1 : 0) + fields.length + (data.note != "" ? 1 : 0);
    property <length> fixed-height: fixed-rows * Theme.popup-row-height + fields.length * 6px + 16px;
    property <int> max-rows: max(1, min(12, floor((root.height - 40px - fixed-height) / Theme.popup-row-height)));
    property <int> list-rows: fields.length > 0 ? max-rows : min(items.length, max-rows);
    // The field with the focus, counted from the top. It goes back to the
    // first field each time a popup opens or another takes its place.
    property <int> focused-field: 0;
    property <int> generation: root.data.generation;

    changed generation => {
        root.focused-field = 0;
    }

    // Dims the window and swallows clicks while the popup is open.
    Rectangle {
        background: Palette.background;
        opacity: 0.6;
    }

    // The wheel stops here too, short of the panes underneath.
    TouchArea {
        scroll-event(event) => {
            accept
        }
    }

    // The labels are measured so that both fields line up at the width of the
    // longer one; a fixed width was cut off at large fonts.
    first-label := PopupText {
        visible: false;
        text: root.fields.length >= 1 ? root.fields[0].label : "";
    }

    second-label := PopupText {
        visible: false;
        text: root.fields.length >= 2 ? root.fields[1].label : "";
    }

    panel := Rectangle {
        width: min(root.width - 40px, 480px);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 3;
        background: Palette.alternate-background;
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 4px;

        content := VerticalLayout {
            padding: 8px;
            spacing: 0;

            PopupText {
                text: data.title;
                font-weight: 700;
                height: Theme.popup-row-height;
                vertical-alignment: center;
            }

            if data.message != "": PopupText {
                text: data.message;
                overflow: elide;
                height: Theme.popup-row-height;
                vertical-alignment: center;
            }

            if root.fields.length >= 1: PopupInput {
                field: root.fields[0];
                labelled: root.fields.length >= 2;
                label-width: max(first-label.preferred-width, second-label.preferred-width);
                single: root.fields.length == 1;
                active: root.focused-field == 0;
                generation: root.data.generation;
                open: root.data.visible;
                text <=> root.text;
                key-input(text, control, shift, alt, meta) => {
                    root.key-input(text, control, shift, alt, meta);
                }
                edited(text) => {
                    root.input-edited(0, text);
                }
                accepted => {
                    root.input-accepted();
                }
                move-focus => {
                    root.focused-field = 1;
                }
            }

            if root.fields.length >= 2: PopupInput {
                field: root.fields[1];
                labelled: true;
                label-width: max(first-label.preferred-width, second-label.preferred-width);
                single: false;
                active: root.focused-field == 1;
                generation: root.data.generation;
                open: root.data.visible;
                text <=> root.text-2;
                key-input(text, control, shift, alt, meta) => {
                    root.key-input(text, control, shift, alt, meta);
                }
                edited(text) => {
                    root.input-edited(1, text);
                }
                accepted => {
                    root.input-accepted();
                }
                move-focus => {
                    root.focused-field = 0;
                }
            }

            if data.note != "": PopupText {
                text: data.note;
                opacity: Theme.popup-dim-text-alpha;
                overflow: elide;
                height: Theme.popup-row-height;
                vertical-alignment: center;
            }

            if data.has-list: Rectangle {
                property <int> top: root.data.scroll-top;

                height: root.list-rows * Theme.popup-row-height;
                clip: true;

                // The list is made anew with each popup, and `changed` does
                // not run at creation.
                init => {
                    list.content-y = -self.top * Theme.popup-row-height;
                }

                changed top => {
                    list.content-y = -self.top * Theme.popup-row-height;
                }

                list := ListView {
                    width: parent.width;
                    height: parent.height;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                    changed visible-height => {
                        root.list-rows-changed(floor(self.visible-height / Theme.popup-row-height));
                    }

                    for item[index] in root.items: Rectangle {
                        height: Theme.popup-row-height;
                        background: index == root.data.cursor ? Theme.selection-background : transparent;

                        if item.kind == 2: Rectangle {
                            height: Theme.line-width;
                            y: (parent.height - self.height) / 2;
                            background: Palette.border;
                        }

                        if item.kind != 2: HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 8px;

                            if item.kind == 1: CheckBox {
                                width: 18px;
                                checked: item.on;
                            }

                            PopupText {
                                text: item.label;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            PopupText {
                                text: item.detail;
                                opacity: Theme.popup-dim-text-alpha;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                horizontal-stretch: 0;
                                min-width: self.preferred-width;
                            }
                        }
                    }
                }

                // The widgets only display the draft; clicks never reach them.
                TouchArea {
                    clicked => {
                        root.row-clicked(floor((self.mouse-y - list.content-y) / Theme.popup-row-height));
                    }

                    double-clicked => {
                        root.row-double-clicked(floor((self.mouse-y - list.content-y) / Theme.popup-row-height));
                    }

                    scroll-event(event) => {
                        root.wheel(event.delta-y);
                        accept
                    }
                }
            }
        }
    }
}
