import { Palette } from "std-widgets.slint";

export global Theme {
    out property <length> row-height: 20px;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <brush> mark-color: dark ? #e74c3c : #c0392b;
    out property <brush> selection-background: Palette.accent-background.with-alpha(0.3);
}
