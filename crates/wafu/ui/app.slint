import { ListView, Palette } from "std-widgets.slint";
import { PaneData, PaneWidget, Row } from "pane.slint";
import { PopupData, PopupField, PopupItem, PopupOverlay } from "popup.slint";
import { PreviewData, PreviewLine, PreviewWidget } from "preview.slint";
import { ScrollBar } from "scrollbar.slint";
import { Theme, ThemeColors } from "theme.slint";

export { PaneData, PopupData, PopupField, PopupItem, PreviewData, PreviewLine, Row, Theme, ThemeColors }

export component AppWindow inherits Window {
    in property <string> window-title: "wafu";
    in property <PaneData> left;
    in property <PaneData> right;
    in property <[Row]> left-rows;
    in property <[Row]> right-rows;
    in property <[bool]> left-marks;
    in property <[bool]> right-marks;
    in property <int> left-scroll-top;
    in property <int> right-scroll-top;
    in property <string> size-sample;
    in property <int> split-percent: 50;
    in property <int> log-rows: 6;
    in property <[string]> log-lines;
    in property <int> log-scroll-top;
    in property <PopupData> popup;
    in property <[PopupItem]> popup-items;
    // The input fields of the popup, at most two, and their texts.
    in property <[PopupField]> popup-fields;
    in-out property <string> popup-text;
    in-out property <string> popup-text-2;
    in property <PreviewData> preview;
    in property <[PreviewLine]> preview-lines;
    in property <string> preview-number-sample;
    in property <image> preview-image;
    in property <bool> preview-has-image;
    in property <bool> hide-log;
    in property <string> status;
    // 0: follow the OS, 1: light, 2: dark
    in property <int> theme;
    in property <bool> menu-bar-visible;
    out property <length> left-list-x: left-pane.list-x;
    out property <length> left-list-y: left-pane.list-y;
    out property <length> right-list-x: right-pane.list-x;
    out property <length> right-list-y: right-pane.list-y;

    callback key-input(text: string, control: bool, shift: bool, alt: bool, meta: bool);
    callback quit-requested();
    callback viewport-rows-changed(side: int, rows: int);
    callback row-clicked(side: int, row: int);
    callback row-double-clicked(side: int, row: int);
    callback row-right-clicked(side: int, row: int, x: length, y: length);
    callback wheel(side: int, delta: length);
    callback scroll-to(side: int, top: int);
    callback log-wheel(delta: length);
    callback log-scroll-to(top: int);
    callback input-edited(field: int, text: string);
    callback input-accepted();
    callback preview-rows-changed(rows: int);
    callback preview-double-clicked();
    callback preview-wheel(delta: length);

    // A progress popup is held back for a moment so that a quick read does not
    // flash an overlay.
    property <bool> progress-shown;

    title: window-title;
    icon: @image-url("../assets/wafu.png");
    preferred-width: 960px;
    preferred-height: 640px;
    forward-focus: scope;
    background: Theme.colors.bg;

    function apply-theme() {
        Palette.color-scheme = root.theme == 1 ? ColorScheme.light
            : root.theme == 2 ? ColorScheme.dark
            : ColorScheme.unknown;
    }

    init => {
        root.apply-theme();
    }

    changed theme => {
        root.apply-theme();
    }

    // Only macOS shows the bar (it is native there), but a hidden bar still
    // handles its shortcuts, so the shortcuts come and go with it. Quit is in
    // the application menu that the platform adds on its own; closing the
    // only window is the same as quitting.
    MenuBar {
        visible: root.menu-bar-visible;

        Menu {
            title: "Window";

            MenuItem {
                title: "Minimize";
                shortcut: root.menu-bar-visible ? @keys(Control + M) : @keys();
                activated => {
                    root.minimized = true;
                }
            }

            MenuItem {
                title: "Close Window";
                shortcut: root.menu-bar-visible ? @keys(Control + W) : @keys();
                activated => {
                    root.quit-requested();
                }
            }
        }
    }

    // Focus returns to the scope whenever no input field can hold it, including
    // when an input popup gives way to a progress popup.
    changed popup => {
        if !root.popup.visible {
            root.progress-shown = false;
        }
        if !root.popup.has-input {
            scope.focus();
        }
    }

    Timer {
        interval: 200ms;
        running: root.popup.visible && root.popup.progress && !root.progress-shown;
        triggered => {
            root.progress-shown = true;
        }
    }

    changed log-scroll-top => {
        log.content-y = -log-scroll-top * Theme.log-row-height;
    }

    scope := FocusScope {
        key-pressed(event) => {
            root.key-input(
                event.text,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt,
                event.modifiers.meta
            );
            accept
        }

        VerticalLayout {
            panes := Rectangle {
                vertical-stretch: 1;

                property <length> left-width: (self.width - Theme.line-width) * root.split-percent / 100;
                // A pane under a preview is hidden rather than removed, so
                // that its list keeps its scroll position.
                property <bool> left-covered: root.preview.visible && root.preview.full;
                property <bool> right-covered: root.preview.visible;

                left-pane := PaneWidget {
                    x: 0;
                    width: panes.left-width;
                    height: parent.height;
                    visible: !panes.left-covered;
                    data: root.left;
                    rows: root.left-rows;
                    marks: root.left-marks;
                    scroll-top: root.left-scroll-top;
                    size-sample: root.size-sample;
                    viewport-rows-changed(rows) => {
                        root.viewport-rows-changed(0, rows);
                    }
                    row-clicked(row) => {
                        root.row-clicked(0, row);
                    }
                    row-double-clicked(row) => {
                        root.row-double-clicked(0, row);
                    }
                    row-right-clicked(row, x, y) => {
                        root.row-right-clicked(0, row, x, y);
                    }
                    wheel(delta) => {
                        root.wheel(0, delta);
                    }
                    scroll-to(top) => {
                        root.scroll-to(0, top);
                    }
                }

                Rectangle {
                    x: panes.left-width;
                    width: Theme.line-width;
                    height: parent.height;
                    background: Palette.border;
                }

                right-pane := PaneWidget {
                    x: panes.left-width + Theme.line-width;
                    width: parent.width - panes.left-width - Theme.line-width;
                    height: parent.height;
                    visible: !panes.right-covered;
                    data: root.right;
                    rows: root.right-rows;
                    marks: root.right-marks;
                    scroll-top: root.right-scroll-top;
                    size-sample: root.size-sample;
                    viewport-rows-changed(rows) => {
                        root.viewport-rows-changed(1, rows);
                    }
                    row-clicked(row) => {
                        root.row-clicked(1, row);
                    }
                    row-double-clicked(row) => {
                        root.row-double-clicked(1, row);
                    }
                    row-right-clicked(row, x, y) => {
                        root.row-right-clicked(1, row, x, y);
                    }
                    wheel(delta) => {
                        root.wheel(1, delta);
                    }
                    scroll-to(top) => {
                        root.scroll-to(1, top);
                    }
                }

                if root.preview.visible: PreviewWidget {
                    x: root.preview.full ? 0 : panes.left-width + Theme.line-width;
                    width: root.preview.full ? parent.width : parent.width - panes.left-width - Theme.line-width;
                    height: parent.height;
                    data: root.preview;
                    lines: root.preview-lines;
                    number-sample: root.preview-number-sample;
                    picture: root.preview-image;
                    has-picture: root.preview-has-image;
                    rows-changed(rows) => {
                        root.preview-rows-changed(rows);
                    }
                    double-clicked => {
                        root.preview-double-clicked();
                    }
                    wheel(delta) => {
                        root.preview-wheel(delta);
                    }
                }
            }

            Rectangle {
                height: root.hide-log ? 0 : Theme.line-width;
                background: Palette.border;
            }

            Rectangle {
                height: root.hide-log ? 0 : root.log-rows * Theme.log-row-height + 8px;
                visible: !root.hide-log;
                clip: true;

                log := ListView {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px - (log-bar.needed ? log-bar.width : 0px);
                    height: max(0px, parent.height - 8px);
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                    changed viewport-height => {
                        self.content-y = -root.log-scroll-top * Theme.log-row-height;
                    }

                    for line in root.log-lines: Text {
                        text: line;
                        height: Theme.log-row-height;
                        font-family: Theme.log-font-family;
                        font-size: Theme.log-font-size;
                        color: Theme.colors.fg;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                // Same as the panes: the core owns the scroll position.
                TouchArea {
                    scroll-event(event) => {
                        root.log-wheel(event.delta-y);
                        accept
                    }
                }

                log-bar := ScrollBar {
                    x: parent.width - 4px - self.width;
                    y: 4px;
                    height: max(0px, parent.height - 8px);
                    top: root.log-scroll-top;
                    rows: root.log-lines.length;
                    visible-rows: root.log-rows;

                    scroll-to(top) => {
                        root.log-scroll-to(top);
                    }

                    wheel(delta) => {
                        root.log-wheel(delta);
                    }
                }
            }

            Rectangle {
                height: Theme.line-width;
                background: Palette.border;
            }

            Rectangle {
                height: Theme.status-row-height;
                clip: true;

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;

                    Text {
                        text: root.status;
                        font-family: Theme.status-font-family;
                        font-size: Theme.status-font-size;
                        color: Theme.colors.fg;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if root.popup.visible && (!root.popup.progress || root.progress-shown): PopupOverlay {
        width: parent.width;
        height: parent.height;
        data: root.popup;
        items: root.popup-items;
        fields: root.popup-fields;
        text <=> root.popup-text;
        text-2 <=> root.popup-text-2;
        key-input(text, control, shift, alt, meta) => {
            root.key-input(text, control, shift, alt, meta);
        }
        input-edited(field, text) => {
            root.input-edited(field, text);
        }
        input-accepted => {
            root.input-accepted();
        }
    }
}
