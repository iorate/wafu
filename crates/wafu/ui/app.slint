import { Palette } from "std-widgets.slint";
import { PaneData, PaneWidget, Row } from "pane.slint";
import { PopupData, PopupField, PopupItem, PopupLine, PopupOverlay } from "popup.slint";
import { PreviewData, PreviewLine, PreviewWidget } from "preview.slint";
import { ScrollBar } from "scrollbar.slint";
import { Theme, ThemeColors } from "theme.slint";

export { PaneData, PopupData, PopupField, PopupItem, PopupLine, PreviewData, PreviewLine, Row, Theme, ThemeColors }

export struct LogLine {
    index: int,
    text: string,
}

// A log line in whole rows, the rows of a wrapped line as far apart as the
// lines, so that the area is cut between rows.
component LogText inherits Text {
    // How far apart the font puts the rows of a wrapped line, which the
    // spacing is relative to.
    in property <length> natural-row-pitch;
    out property <int> rows: max(1, round(self.preferred-height / Theme.log-row-height));

    height: self.rows * Theme.log-row-height;
    font-family: Theme.log-font-family;
    font-size: Theme.log-font-size;
    color: Theme.colors.fg;
    // Works with the FemtoVG renderer too, though the documentation lists
    // only Qt and software.
    wrap: char-wrap;
    line-height-factor: Theme.log-row-height / self.natural-row-pitch;
    // From the top, so that the first row sits the same in its row of the
    // area however many rows follow it.
    vertical-alignment: top;
}

export component AppWindow inherits Window {
    in property <string> window-title: "wafu";
    in property <PaneData> left;
    in property <PaneData> right;
    in property <[Row]> left-rows;
    in property <[Row]> right-rows;
    in property <[bool]> left-marks;
    in property <[bool]> right-marks;
    in property <int> left-scroll-top;
    in property <int> right-scroll-top;
    in property <string> size-sample;
    in property <string> time-sample;
    in property <string> extension-sample;
    in property <string> name-sample;
    in property <int> split-percent: 50;
    in property <int> log-rows: 6;
    in property <[LogLine]> log-shown;
    in property <[LogLine]> log-before;
    in property <[LogLine]> log-tail;
    in property <int> log-line-count;
    in property <int> log-scroll-top;
    in property <int> log-end;
    in property <PopupData> popup;
    in property <[PopupItem]> popup-items;
    // The input fields of the popup, at most two, and their texts.
    in property <[PopupField]> popup-fields;
    in-out property <string> popup-text;
    in-out property <string> popup-text-2;
    // The items of the popup's list that only shows them: those shown from
    // its top, and those only measured.
    in property <[PopupLine]> popup-lines-shown;
    in property <[PopupLine]> popup-lines-before;
    in property <[PopupLine]> popup-lines-tail;
    in property <PreviewData> preview;
    in property <[PreviewLine]> preview-lines;
    in property <[PreviewLine]> preview-before;
    in property <[PreviewLine]> preview-tail;
    in property <string> preview-number-sample;
    in property <image> preview-image;
    in property <bool> preview-has-image;
    in property <bool> hide-log;
    in property <string> status;
    // 0: follow the OS, 1: light, 2: dark
    in property <int> theme;
    in property <bool> menu-bar-visible;
    out property <length> left-list-x: left-pane.list-x;
    out property <length> left-top-row-y: left-pane.top-row-y;
    out property <length> right-list-x: right-pane.list-x;
    out property <length> right-top-row-y: right-pane.top-row-y;

    callback key-input(text: string, control: bool, shift: bool, alt: bool, meta: bool);
    callback quit-requested();
    callback viewport-rows-changed(side: int, rows: int);
    callback row-clicked(side: int, row: int);
    callback row-double-clicked(side: int, row: int);
    callback row-right-clicked(side: int, row: int, x: length, y: length);
    callback wheel(side: int, delta: length);
    callback scroll-to(side: int, top: int);
    callback log-wheel(delta: length);
    callback log-scroll-to(top: int);
    callback log-line-rows(index: int, rows: int);
    callback split-dragged(percent: int);
    callback log-resized(rows: int);
    callback input-edited(field: int, text: string);
    callback input-accepted();
    callback preview-rows-changed(rows: int);
    callback preview-double-clicked();
    callback preview-wheel(delta: length);
    callback preview-scroll-to(top: int);
    callback preview-line-rows(index: int, rows: int);
    callback popup-rows-changed(rows: int);
    callback popup-row-clicked(row: int);
    callback popup-row-double-clicked(row: int);
    callback popup-wheel(delta: length);
    callback popup-lines-rows-changed(rows: int);
    callback popup-line-rows(index: int, rows: int);
    callback popup-lines-scroll-to(top: int);

    // A progress popup is held back for a moment so that a quick read does not
    // flash an overlay.
    property <bool> progress-shown;
    property <int> progress-generation;

    // Slint takes the focus away from the scope when the window goes inactive,
    // so this doubles as the window's state. An input popup takes it too, and
    // the dimmed cursor under the popup is intended.
    property <bool> window-active: scope.has-focus;

    title: window-title;
    icon: @image-url("../assets/wafu.png");
    preferred-width: 960px;
    preferred-height: 640px;
    forward-focus: scope;
    background: Theme.colors.bg;

    function apply-theme() {
        Palette.color-scheme = root.theme == 1 ? ColorScheme.light
            : root.theme == 2 ? ColorScheme.dark
            : ColorScheme.unknown;
    }

    init => {
        root.apply-theme();
    }

    changed theme => {
        root.apply-theme();
    }

    // Only macOS shows the bar (it is native there), but a hidden bar still
    // handles its shortcuts, so the shortcuts come and go with it. Closing
    // the only window is the same as quitting. A MenuBar cannot be placed
    // inside `if`, hence `visible`.
    MenuBar {
        visible: root.menu-bar-visible;

        Menu {
            title: "Window";

            MenuItem {
                title: "Minimize";
                shortcut: root.menu-bar-visible ? @keys(Control + M) : @keys();
                activated => {
                    root.minimized = true;
                }
            }

            MenuItem {
                title: "Close Window";
                shortcut: root.menu-bar-visible ? @keys(Control + W) : @keys();
                activated => {
                    root.quit-requested();
                }
            }

            // Slint moves this item into the application menu, in place of
            // the Quit it adds on its own, and gives it Cmd+Q. That Quit would
            // end the process without going through close-requested
            // (slint-ui/slint#4482), so nothing would be saved.
            MenuItem {
                title: "Quit wafu";
                role: quit;
                activated => {
                    root.quit-requested();
                }
            }
        }
    }

    // Focus returns to the scope whenever no input field can hold it, including
    // when an input popup gives way to a progress popup.
    changed popup => {
        if !root.popup.visible {
            root.progress-shown = false;
        }
        // A progress popup that comes to report another wait is delayed
        // afresh, even if it is already shown: that wait has only just begun.
        // The generation of a popup that is not a progress popup is left
        // alone, so that the progress of an operation comes back at once
        // after a question asked in the middle of it.
        if root.popup.visible && root.popup.progress && root.popup.generation != root.progress-generation {
            root.progress-generation = root.popup.generation;
            // Only a running timer is restarted; one that is stopped starts
            // from zero when `progress-shown` is cleared.
            if !root.progress-shown {
                progress-delay.restart();
            }
            root.progress-shown = false;
        }
        if !root.popup.has-input {
            scope.focus();
        }
    }

    progress-delay := Timer {
        interval: 200ms;
        running: root.popup.visible && root.popup.progress && !root.progress-shown;
        triggered => {
            root.progress-shown = true;
        }
    }

    // The log keeps this width whether or not its scrollbar is shown, so
    // that the scrollbar never changes how many rows the lines take.
    property <length> log-text-width: root.width - 8px - Theme.scrollbar-gutter;

    // What a row adds to a wrapped line. A Text's preferred height is rounded
    // up to a whole pixel, so ten rows' difference is taken.
    property <length> log-row-pitch: (log-eleven-lines.preferred-height - log-one-line.preferred-height) / 10;

    log-one-line := Text {
        text: " ";
        font-family: Theme.log-font-family;
        font-size: Theme.log-font-size;
        visible: false;
    }

    log-eleven-lines := Text {
        text: " \n \n \n \n \n \n \n \n \n \n ";
        font-family: Theme.log-font-family;
        font-size: Theme.log-font-size;
        visible: false;
    }

    // Every line the core hands over is measured here, outside the log, so
    // that the log measures the same while it is hidden. Each one is hidden
    // on its own: a repeater under a parent that is not drawn may never make
    // its elements.
    for line in root.log-shown: LogText {
        visible: false;
        width: root.log-text-width;
        natural-row-pitch: root.log-row-pitch;
        text: line.text;
        init => {
            root.log-line-rows(line.index, self.rows);
        }
        changed rows => {
            root.log-line-rows(line.index, self.rows);
        }
    }

    for line in root.log-before: LogText {
        visible: false;
        width: root.log-text-width;
        natural-row-pitch: root.log-row-pitch;
        text: line.text;
        init => {
            root.log-line-rows(line.index, self.rows);
        }
        changed rows => {
            root.log-line-rows(line.index, self.rows);
        }
    }

    for line in root.log-tail: LogText {
        visible: false;
        width: root.log-text-width;
        natural-row-pitch: root.log-row-pitch;
        text: line.text;
        init => {
            root.log-line-rows(line.index, self.rows);
        }
        changed rows => {
            root.log-line-rows(line.index, self.rows);
        }
    }

    // Every key, Tab included, ends here, so that Slint never moves the focus
    // on its own. Keys typed in the list and previews never go through the
    // IME: it runs only while an editable TextInput has focus, and there is no
    // API to turn it off (slint-ui/slint#3811).
    scope := FocusScope {
        key-pressed(event) => {
            root.key-input(
                event.text,
                event.modifiers.control,
                event.modifiers.shift,
                event.modifiers.alt,
                event.modifiers.meta
            );
            accept
        }

        VerticalLayout {
            // The panes are placed by hand: in a layout their text widths would
            // move the divider with every listing.
            panes := Rectangle {
                vertical-stretch: 1;

                property <length> left-width: (self.width - Theme.line-width) * root.split-percent / 100;
                // A pane under a preview is hidden rather than removed, so
                // that its list keeps its scroll position.
                property <bool> left-covered: root.preview.visible && root.preview.covers-left;
                property <bool> right-covered: root.preview.visible && root.preview.covers-right;

                left-pane := PaneWidget {
                    // Without `x`, an element narrower than its parent is
                    // centred.
                    x: 0;
                    width: panes.left-width;
                    height: parent.height;
                    visible: !panes.left-covered;
                    data: root.left;
                    rows: root.left-rows;
                    marks: root.left-marks;
                    scroll-top: root.left-scroll-top;
                    size-sample: root.size-sample;
                    time-sample: root.time-sample;
                    extension-sample: root.extension-sample;
                    name-sample: root.name-sample;
                    window-active: root.window-active;
                    viewport-rows-changed(rows) => {
                        root.viewport-rows-changed(0, rows);
                    }
                    row-clicked(row) => {
                        root.row-clicked(0, row);
                    }
                    row-double-clicked(row) => {
                        root.row-double-clicked(0, row);
                    }
                    row-right-clicked(row, x, y) => {
                        root.row-right-clicked(0, row, x, y);
                    }
                    wheel(delta) => {
                        root.wheel(0, delta);
                    }
                    scroll-to(top) => {
                        root.scroll-to(0, top);
                    }
                }

                Rectangle {
                    x: panes.left-width;
                    width: Theme.line-width;
                    height: parent.height;
                    background: Palette.border;
                }

                right-pane := PaneWidget {
                    x: panes.left-width + Theme.line-width;
                    width: parent.width - panes.left-width - Theme.line-width;
                    height: parent.height;
                    visible: !panes.right-covered;
                    data: root.right;
                    rows: root.right-rows;
                    marks: root.right-marks;
                    scroll-top: root.right-scroll-top;
                    size-sample: root.size-sample;
                    time-sample: root.time-sample;
                    extension-sample: root.extension-sample;
                    name-sample: root.name-sample;
                    window-active: root.window-active;
                    viewport-rows-changed(rows) => {
                        root.viewport-rows-changed(1, rows);
                    }
                    row-clicked(row) => {
                        root.row-clicked(1, row);
                    }
                    row-double-clicked(row) => {
                        root.row-double-clicked(1, row);
                    }
                    row-right-clicked(row, x, y) => {
                        root.row-right-clicked(1, row, x, y);
                    }
                    wheel(delta) => {
                        root.wheel(1, delta);
                    }
                    scroll-to(top) => {
                        root.scroll-to(1, top);
                    }
                }

                if root.preview.visible: PreviewWidget {
                    x: root.preview.covers-left ? 0 : panes.left-width + Theme.line-width;
                    width: root.preview.covers-right ? parent.width - self.x : panes.left-width;
                    height: parent.height;
                    data: root.preview;
                    lines: root.preview-lines;
                    before: root.preview-before;
                    tail: root.preview-tail;
                    number-sample: root.preview-number-sample;
                    picture: root.preview-image;
                    has-picture: root.preview-has-image;
                    rows-changed(rows) => {
                        root.preview-rows-changed(rows);
                    }
                    double-clicked => {
                        root.preview-double-clicked();
                    }
                    wheel(delta) => {
                        root.preview-wheel(delta);
                    }
                    scroll-to(top) => {
                        root.preview-scroll-to(top);
                    }
                    line-rows(index, rows) => {
                        root.preview-line-rows(index, rows);
                    }
                }

                // The grip is wider than the line, so it takes a few pixels
                // off the edges of the panes, the left scrollbar included.
                // The core snaps the percentage to the step of the keys.
                TouchArea {
                    x: panes.left-width - Theme.grip-margin;
                    width: Theme.line-width + Theme.grip-margin * 2;
                    height: parent.height;
                    enabled: !(panes.left-covered && panes.right-covered);
                    mouse-cursor: col-resize;
                    moved => {
                        root.split-dragged(round((self.x + self.mouse-x) / (panes.width - Theme.line-width) * 100));
                    }
                }
            }

            Rectangle {
                height: root.hide-log ? 0 : Theme.line-width;
                background: Palette.border;
            }

            Rectangle {
                height: root.hide-log ? 0 : root.log-rows * Theme.log-row-height + 8px;
                visible: !root.hide-log;
                clip: true;

                Rectangle {
                    x: 4px;
                    y: 4px;
                    width: root.log-text-width;
                    height: root.log-rows * Theme.log-row-height;
                    clip: true;

                    VerticalLayout {
                        alignment: start;

                        for line in root.log-shown: LogText {
                            width: root.log-text-width;
                            natural-row-pitch: root.log-row-pitch;
                            text: line.text;
                        }
                    }
                }

                // Same as the panes: the core owns the scroll position.
                TouchArea {
                    scroll-event(event) => {
                        root.log-wheel(event.delta-y);
                        accept
                    }
                }

                log-bar := ScrollBar {
                    x: parent.width - self.width;
                    y: 4px;
                    height: max(0px, parent.height - 8px);
                    // In lines, the thumb as long as the lines shown at the end,
                    // so that it reaches the bottom just there and keeps its
                    // length while scrolling.
                    top: root.log-scroll-top;
                    rows: root.log-line-count;
                    visible-rows: root.log-line-count - root.log-end;

                    scroll-to(top) => {
                        root.log-scroll-to(top);
                    }

                    wheel(delta) => {
                        root.log-wheel(delta);
                    }
                }
            }

            Rectangle {
                height: Theme.line-width;
                background: Palette.border;
            }

            Rectangle {
                height: Theme.status-row-height;
                clip: true;

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;

                    Text {
                        text: root.status;
                        font-family: Theme.status-font-family;
                        font-size: Theme.status-font-size;
                        color: Theme.colors.fg;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Outside the layout so that the grip can reach past the divider's row.
    // The grip follows the divider, so the pointer's offset from it is how
    // many rows to add.
    if !root.hide-log: TouchArea {
        y: panes.height - Theme.grip-margin;
        width: root.width;
        height: Theme.line-width + Theme.grip-margin * 2;
        mouse-cursor: row-resize;
        moved => {
            root.log-resized(root.log-rows + round((Theme.grip-margin - self.mouse-y) / Theme.log-row-height));
        }
    }

    if root.popup.visible && (!root.popup.progress || root.progress-shown): PopupOverlay {
        width: parent.width;
        height: parent.height;
        data: root.popup;
        items: root.popup-items;
        fields: root.popup-fields;
        lines-shown: root.popup-lines-shown;
        lines-before: root.popup-lines-before;
        lines-tail: root.popup-lines-tail;
        text <=> root.popup-text;
        text-2 <=> root.popup-text-2;
        key-input(text, control, shift, alt, meta) => {
            root.key-input(text, control, shift, alt, meta);
        }
        input-edited(field, text) => {
            root.input-edited(field, text);
        }
        input-accepted => {
            root.input-accepted();
        }
        list-rows-changed(rows) => {
            root.popup-rows-changed(rows);
        }
        row-clicked(row) => {
            root.popup-row-clicked(row);
        }
        row-double-clicked(row) => {
            root.popup-row-double-clicked(row);
        }
        wheel(delta) => {
            root.popup-wheel(delta);
        }
        lines-rows-changed(rows) => {
            root.popup-lines-rows-changed(rows);
        }
        line-rows(index, rows) => {
            root.popup-line-rows(index, rows);
        }
        lines-scroll-to(top) => {
            root.popup-lines-scroll-to(top);
        }
    }
}
