import { ListView, Palette } from "std-widgets.slint";
import { ScrollBar } from "scrollbar.slint";
import { Theme } from "theme.slint";

export struct Row {
    // 0: directory, 1: file, 2: executable, 3: symbolic link, 4: broken
    // symbolic link, 5: FIFO or device, 6: socket
    kind: int,
    name: string,
    extension: string,
    marker: string,
    size: string,
    modified: string,
}

export struct PaneData {
    path: string,
    info: string,
    active: bool,
    cursor: int,
}

export struct ColumnWidths {
    extension: length,
    marker: length,
    size: length,
    modified: length,
}

component Cell inherits Text {
    font-family: Theme.filelist-font-family;
    font-size: Theme.filelist-font-size;
    color: Theme.colors.fg;
    vertical-alignment: center;
}

component RowItem {
    in property <Row> item;
    in property <bool> cursor;
    in property <bool> marked;
    in property <ColumnWidths> columns;

    property <brush> text-color: item.kind == 0 ? Theme.colors.dir
        : item.kind == 2 ? Theme.colors.exec
        : item.kind == 3 ? Theme.colors.link
        : item.kind == 4 ? Theme.colors.broken
        : item.kind == 5 ? Theme.colors.fifo
        : item.kind == 6 ? Theme.colors.socket
        : Theme.colors.fg;

    height: Theme.row-height;

    if marked: Rectangle {
        background: Theme.colors.mark;
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 8px;

        Cell {
            text: item.name;
            color: root.text-color;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Cell {
            text: item.extension;
            color: root.text-color;
            width: root.columns.extension;
            overflow: elide;
        }

        Cell {
            text: item.marker;
            color: root.text-color;
            width: root.columns.marker;
        }

        Cell {
            text: item.size;
            color: root.text-color;
            width: root.columns.size;
            horizontal-alignment: right;
        }

        Cell {
            text: item.modified;
            color: root.text-color;
            width: root.columns.modified;
            horizontal-alignment: right;
        }
    }

    if cursor: Rectangle {
        y: parent.height - Theme.line-width;
        height: Theme.line-width;
        background: Theme.colors.cursor;
    }
}

export component PaneWidget {
    in property <PaneData> data;
    in property <[Row]> rows;
    in property <[bool]> marks;
    in property <int> scroll-top;
    in property <string> size-sample;
    // Where the list is in the window, for a menu below a row.
    out property <length> list-x: area.absolute-position.x;
    out property <length> list-y: area.absolute-position.y;

    callback viewport-rows-changed(rows: int);
    callback row-clicked(row: int);
    callback row-double-clicked(row: int);
    // The pointer position is in window coordinates, for a menu at the pointer.
    callback row-right-clicked(row: int, x: length, y: length);
    callback wheel(delta: length);
    callback scroll-to(top: int);

    // The fixed columns are as wide as a sample of their widest content in
    // the current font.
    property <ColumnWidths> columns: {
        extension: measure-extension.preferred-width,
        marker: measure-marker.preferred-width,
        size: measure-size.preferred-width,
        modified: measure-modified.preferred-width,
    };

    // The same count the core is told, so that the bar's range is the core's.
    property <int> visible-rows;

    changed scroll-top => {
        list.content-y = -scroll-top * Theme.row-height;
    }

    function row-at(y: length) -> int {
        return root.scroll-top + floor(y / Theme.row-height);
    }

    measure-extension := Cell {
        text: ".0000000";
        visible: false;
    }

    measure-marker := Cell {
        text: "@";
        visible: false;
    }

    measure-size := Cell {
        text: root.size-sample;
        visible: false;
    }

    measure-modified := Cell {
        text: "0000/00/00 00:00:00";
        visible: false;
    }

    VerticalLayout {
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            height: Theme.path-row-height;

            Text {
                text: data.path;
                font-family: Theme.path-font-family;
                font-size: Theme.path-font-size;
                color: Theme.colors.fg;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: Theme.line-width;
            background: Palette.border;
        }

        // A pane narrower than its fixed columns cuts the rows off at its
        // edge instead of drawing over the other pane.
        area := Rectangle {
            vertical-stretch: 1;
            clip: true;

            list := ListView {
                x: 0;
                width: parent.width - Theme.scrollbar-gutter;
                height: parent.height;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                changed visible-height => {
                    root.visible-rows = floor(self.visible-height / Theme.row-height);
                    root.viewport-rows-changed(root.visible-rows);
                }

                changed viewport-height => {
                    self.content-y = -root.scroll-top * Theme.row-height;
                }

                for row[index] in root.rows: RowItem {
                    item: row;
                    cursor: index == root.data.cursor;
                    marked: root.marks[index];
                    columns: root.columns;
                }
            }

            // Sits on top of the list so that the core, not the list, owns the
            // scroll position; the list's own wheel handling never runs.
            TouchArea {
                x: 0;
                width: list.width;
                height: parent.height;

                property <bool> right-pressed;

                clicked => {
                    root.row-clicked(root.row-at(self.mouse-y));
                }

                double-clicked => {
                    root.row-double-clicked(root.row-at(self.mouse-y));
                }

                // On release, as the shell does, so that a menu opened by the
                // press is not dismissed by the release.
                pointer-event(event) => {
                    if event.button != PointerEventButton.right {
                        return;
                    }
                    if event.kind == PointerEventKind.down {
                        self.right-pressed = true;
                    } else if event.kind == PointerEventKind.up && self.right-pressed {
                        self.right-pressed = false;
                        root.row-right-clicked(
                            root.row-at(self.mouse-y),
                            self.absolute-position.x + self.mouse-x,
                            self.absolute-position.y + self.mouse-y
                        );
                    } else {
                        self.right-pressed = false;
                    }
                }

                scroll-event(event) => {
                    root.wheel(event.delta-y);
                    accept
                }
            }

            bar := ScrollBar {
                x: parent.width - self.width;
                height: parent.height;
                top: root.scroll-top;
                rows: root.rows.length;
                visible-rows: root.visible-rows;

                scroll-to(top) => {
                    root.scroll-to(top);
                }

                wheel(delta) => {
                    root.wheel(delta);
                }
            }
        }

        Rectangle {
            height: Theme.line-width;
            background: Palette.border;
        }

        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            height: Theme.info-row-height;

            Text {
                text: data.info;
                font-family: Theme.info-font-family;
                font-size: Theme.info-font-size;
                color: Theme.colors.fg;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
}
